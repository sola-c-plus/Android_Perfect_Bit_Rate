<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dap">

    <!-- ドラッグハンドルバー -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#444444"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp" />

    <!-- タイトルバー (DSP SETTINGS + ✕ 閉じるボタン) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DSP SETTINGS"
            android:textColor="#E5A93C"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05" />

        <Button
            android:id="@+id/btnDialogClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="✕"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:background="@drawable/bg_btn_icon"
            android:padding="0dp" />
    </LinearLayout>

    <!-- スクロール可能なDSP設定エリア (weight=1) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- DIRECT SOURCE スイッチ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#161616"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DIRECT SOURCE"
                        android:textColor="#E5A93C"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="全DSPを無効化しダイレクト送信します"
                        android:textColor="#888888"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/dialogSwitchDirectSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@null"
                    app:trackTint="@null"
                    android:thumb="@drawable/switch_thumb_white"
                    app:track="@drawable/switch_track_walkman_outline"
                    android:checked="false" />
            </LinearLayout>

            <!-- 10-BAND EQUALIZER セクション -->
            <LinearLayout
                android:id="@+id/layoutSectionEq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#080808"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10-BAND EQUALIZER"
                            android:textColor="#FFFFFF"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="64bit IIR"
                            android:textColor="#777777"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchEqEnable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@null"
                        app:trackTint="@null"
                        android:thumb="@drawable/switch_thumb_white"
                        app:track="@drawable/switch_track_walkman_outline"
                        android:checked="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.example.perfectbitrate.WalkmanEqView
                        android:id="@+id/walkmanEqView"
                        android:layout_width="wrap_content"
                        android:layout_height="170dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="170dp"
                        android:orientation="vertical"
                        android:gravity="top|center_horizontal"
                        android:paddingTop="12dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <Button
                            android:id="@+id/btnEqEdit"
                            android:layout_width="58dp"
                            android:layout_height="28dp"
                            android:text="調整"
                            android:textColor="#FFFFFF"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_btn_dap_outline"
                            android:padding="0dp"
                            android:layout_marginBottom="8dp" />

                        <Button
                            android:id="@+id/btnEqFlat"
                            android:layout_width="58dp"
                            android:layout_height="28dp"
                            android:text="FLAT"
                            android:textColor="#888888"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_btn_dap_outline"
                            android:padding="0dp"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:id="@+id/layoutEqAdjustControls"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/textEqBandFreq"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4K Hz"
                                android:textColor="#CCCCCC"
                                android:textSize="10.5sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-condensed" />

                            <TextView
                                android:id="@+id/textEqGainValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+0.0 dB"
                                android:textColor="#FFFFFF"
                                android:textSize="11.5sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginBottom="4dp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/btnEqPlus"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:text="＋"
                                    android:textColor="#FFFFFF"
                                    android:textSize="10.5sp"
                                    android:background="@drawable/bg_btn_circle"
                                    android:padding="0dp"
                                    android:layout_marginEnd="6dp" />

                                <Button
                                    android:id="@+id/btnEqMinus"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:text="－"
                                    android:textColor="#FFFFFF"
                                    android:textSize="10.5sp"
                                    android:background="@drawable/bg_btn_circle"
                                    android:padding="0dp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- 1. 出力ビット深度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BIT DEPTH FORMAT"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DACへ伝送するPCMビット深度"
                        android:textColor="#777777"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/dialogSpinnerBitDepth"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_spinner_dap"
                    android:popupBackground="#1A1A1A" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C1C1C"
                android:layout_marginBottom="12dp" />

            <!-- 2. ディザリング方式 -->
            <LinearLayout
                android:id="@+id/layoutSectionDither"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DITHERING ALGORITHM"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="量子化ノイズ分散・SMBシェービング"
                        android:textColor="#777777"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/dialogSpinnerDither"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_spinner_dap"
                    android:popupBackground="#1A1A1A" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C1C1C"
                android:layout_marginBottom="12dp" />

            <!-- 3. DC PHASE LINEARIZER -->
            <LinearLayout
                android:id="@+id/layoutSectionDcPhase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DC PHASE LINEARIZER"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="アナログアンプ低域位相 (A/B Curve 2/4/8Hz)"
                        android:textColor="#777777"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/dialogSpinnerDcPhase"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_spinner_dap"
                    android:popupBackground="#1A1A1A" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C1C1C"
                android:layout_marginBottom="12dp" />

            <!-- 4. HIGH-FREQ RESTORATION -->
            <LinearLayout
                android:id="@+id/layoutSectionDsee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HIGH-FREQ RESTORATION"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OPUS251などの圧縮コーデックで不足しがちの、高域(20k~40kHz)を補完"
                        android:textColor="#777777"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/dialogSpinnerDsee"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_spinner_dap"
                    android:popupBackground="#1A1A1A" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C1C1C"
                android:layout_marginBottom="12dp" />

            <!-- 5. アップサンプリング DSP -->
            <LinearLayout
                android:id="@+id/layoutSectionUpsample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ULTRA HQ UPSAMPLING"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ARM NEON 高タップ数ポリフェーズFIR"
                        android:textColor="#777777"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/dialogSpinnerUpsample"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_spinner_dap"
                    android:popupBackground="#1A1A1A" />
            </LinearLayout>

            <!-- 5-2. MULTISTAGE CASCADE FIR スイッチ -->
            <LinearLayout
                android:id="@+id/layoutSectionCascadeFir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MULTISTAGE CASCADE FIR"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3段2x多段接続 (255→63→39 taps) で-140dB超低ノイズ化"
                        android:textColor="#777777"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/dialogSwitchCascadeFir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@null"
                    app:trackTint="@null"
                    android:thumb="@drawable/switch_thumb_white"
                    app:track="@drawable/switch_track_walkman_outline"
                    android:checked="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C1C1C"
                android:layout_marginBottom="12dp" />

            <!-- 6. 0dB Volume Lock (音量キーで曲スキップ) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dialogTextVolLockTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0dB VOLUME LOCK"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dialogTextVolLockSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="最大音量固定（ビット落ち防止） / 音量UP:次へ / DOWN:前へ"
                        android:textColor="#777777"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/dialogSwitchVolLock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@null"
                    app:trackTint="@null"
                    android:thumb="@drawable/switch_thumb_white"
                    app:track="@drawable/switch_track_walkman_outline" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C1C1C"
                android:layout_marginBottom="12dp" />

            <!-- 7. AD CUT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AD CUT (広告自動カット)"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YouTube Music 動画広告の自動スキップ"
                        android:textColor="#777777"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/dialogSwitchAdBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@null"
                    app:trackTint="@null"
                    android:thumb="@drawable/switch_thumb_white"
                    app:track="@drawable/switch_track_walkman_outline"
                    android:checked="true" />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ★ Xperia Music 風 下部固定ミニプレイヤーバー (大サムネ + 右配置シークバー + 大文字) -->
    <LinearLayout
        android:id="@+id/layoutDialogPlayerControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#161616"
        android:elevation="12dp">

        <!-- 上部境界線 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#262626" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- 1. 左側: 大きなサムネイル / アルバムアート (角丸 58dp x 58dp) -->
            <androidx.cardview.widget.CardView
                android:layout_width="58dp"
                android:layout_height="58dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#222222">

                <ImageView
                    android:id="@+id/dialogImageArtwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_badge_normal" />
            </androidx.cardview.widget.CardView>

            <!-- 2. サムネイルの右側: [曲名/アーティスト] + [シークバー] -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="6dp">

                <!-- 曲名 ＆ アーティスト (文字サイズ拡大) -->
                <TextView
                    android:id="@+id/dialogTextTrackTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="YouTube Music"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/dialogTextTrackArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#BDBDBD"
                    android:textSize="12.5sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_marginTop="1dp" />

                <!-- サムネイルの右に収まるシークバー ＆ 経過/総時間 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/dialogTextCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="#888888"
                        android:textSize="10.5sp"
                        android:fontFamily="monospace" />

                    <SeekBar
                        android:id="@+id/dialogSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progress="0"
                        android:progressTint="#E5A93C"
                        android:thumbTint="#FFFFFF"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp" />

                    <TextView
                        android:id="@+id/dialogTextTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="#888888"
                        android:textSize="10.5sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

            </LinearLayout>

            <!-- 3. 右端: 白丸枠ボタン群 (前へ / 再生・一時停止 / 次へ) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/dialogBtnPrevTrack"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:text="⏮"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_walkman_circle_small"
                    android:padding="0dp"
                    android:gravity="center"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/dialogBtnPlayPause"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:text="▶"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_walkman_circle_large"
