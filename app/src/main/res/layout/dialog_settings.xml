<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dap"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <!-- ドラッグハンドルバー -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#444444"
        android:layout_marginBottom="10dp" />

    <!-- タイトルバー -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WALKMAN 1Z MASTER DSP"
            android:textColor="#E5A93C"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05" />

        <Button
            android:id="@+id/btnDialogClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="✕"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:background="@drawable/bg_btn_icon"
            android:padding="0dp" />
    </LinearLayout>

    <!-- DIRECT SOURCE (全DSPバイパス) スイッチ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#161616"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIRECT SOURCE (全DSPバイパス)"
                android:textColor="#E5A93C"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全DSPを無効化し、原音生ストリームを1:1ダイレクト伝送"
                android:textColor="#888888"
                android:textSize="9.5sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/dialogSwitchDirectSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@null"
            app:trackTint="@null"
            android:thumb="@drawable/switch_thumb_white"
            app:track="@drawable/switch_track_walkman_outline"
            android:checked="false" />
    </LinearLayout>

    <!-- ★ 10-BAND EQ セクション (実機プロポーション 185dp) -->
    <LinearLayout
        android:id="@+id/layoutSectionEq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#080808"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:id="@+id/layoutEqAdjustControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textEqBandFreq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4K Hz"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed" />

                <TextView
                    android:id="@+id/textEqGainValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="+0.0 dB"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <Button
                    android:id="@+id/btnEqPlus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:text="＋"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_btn_circle"
                    android:layout_marginStart="8dp"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/btnEqMinus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:text="－"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_btn_circle"
                    android:layout_marginStart="4dp"
                    android:padding="0dp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnEqFlat"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="FLAT"
                android:textColor="#888888"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_dap_outline"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnEqEdit"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="調整"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_dap_outline"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EQ"
                android:textColor="#AAAAAA"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEqEnable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@null"
                app:trackTint="@null"
                android:thumb="@drawable/switch_thumb_white"
                app:track="@drawable/switch_track_walkman_outline"
                android:checked="false" />
        </LinearLayout>

        <com.example.perfectbitrate.WalkmanEqView
            android:id="@+id/walkmanEqView"
            android:layout_width="match_parent"
            android:layout_height="185dp" />

    </LinearLayout>

    <!-- 1. 出力ビット深度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BIT DEPTH FORMAT"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DACへ伝送するPCMビット深度"
                android:textColor="#777777"
                android:textSize="9.5sp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/dialogSpinnerBitDepth"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_spinner_dap"
            android:popupBackground="#1A1A1A" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1C1C1C"
        android:layout_marginBottom="12dp" />

    <!-- 2. ディザリング方式 -->
    <LinearLayout
        android:id="@+id/layoutSectionDither"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DITHERING ALGORITHM"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="量子化ノイズ分散・SBM心理音響シェーピング"
                android:textColor="#777777"
                android:textSize="9.5sp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/dialogSpinnerDither"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_spinner_dap"
            android:popupBackground="#1A1A1A" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1C1C1C"
        android:layout_marginBottom="12dp" />

    <!-- 3. FIR フィルター特性切り替え -->
    <LinearLayout
        android:id="@+id/layoutSectionFir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FIR FILTER CHARACTER"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="直線位相/最小位相 (プリリンギング・余韻)"
                android:textColor="#777777"
                android:textSize="9.5sp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/dialogSpinnerFirFilter"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_spinner_dap"
            android:popupBackground="#1A1A1A" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1C1C1C"
        android:layout_marginBottom="12dp" />

    <!-- 4. DC PHASE LINEARIZER -->
    <LinearLayout
        android:id="@+id/layoutSectionDcPhase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DC PHASE LINEARIZER"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="アナログアンプ低域位相 (A/B Curve 2/4/8Hz)"
                android:textColor="#777777"
                android:textSize="9.5sp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/dialogSpinnerDcPhase"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_spinner_dap"
            android:popupBackground="#1A1A1A" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1C1C1C"
        android:layout_marginBottom="12dp" />

    <!-- 5. HIGH-FREQ RESTORATION (高音補完) -->
    <LinearLayout
        android:id="@+id/layoutSectionDsee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH-FREQ RESTORATION"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opus 251 高域補完 (DSEE風 20k〜40kHz+ 倍音合成)"
                android:textColor="#777777"
                android:textSize="9.5sp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/dialogSpinnerDsee"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_spinner_dap"
            android:popupBackground="#1A1A1A" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1C1C1C"
        android:layout_marginBottom="12dp" />

    <!-- 6. アップサンプリング DSP -->
    <LinearLayout
        android:id="@+id/layoutSectionUpsample"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ULTRA HQ UPSAMPLING"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARM NEON 高タップ数ポリフェーズFIR"
                android:textColor="#777777"
                android:textSize="9.5sp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/dialogSpinnerUpsample"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_spinner_dap"
            android:popupBackground="#1A1A1A" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1C1C1C"
        android:layout_marginBottom="12dp" />

    <!-- 7. 0dB Volume Lock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialogTextVolLockTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0dB VOLUME LOCK"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialogTextVolLockSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB DAC接続時のビット落ち回避（最大音量固定）"
                android:textColor="#777777"
                android:textSize="9.5sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/dialogSwitchVolLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@null"
            app:trackTint="@null"
            android:thumb="@drawable/switch_thumb_white"
            app:track="@drawable/switch_track_walkman_outline" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1C1C1C"
        android:layout_marginBottom="12dp" />

    <!-- 8. AD CUT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AD CUT (広告自動カット)"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YouTube Music 動画広告の自動スキップ"
                android:textColor="#777777"
                android:textSize="9.5sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/dialogSwitchAdBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@null"
            app:trackTint="@null"
            android:thumb="@drawable/switch_thumb_white"
            app:track="@drawable/switch_track_walkman_outline"
            android:checked="true" />
    </LinearLayout>

</LinearLayout>