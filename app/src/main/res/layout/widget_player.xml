<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_widget_player"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <!-- サムネイル / アルバムアート -->
    <ImageView
        android:id="@+id/widgetImageArtwork"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_badge_normal" />

    <!-- 中央: 曲名 ＆ アーティスト ＆ シークバー ＆ 時間 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp">

        <!-- 1段目: 曲名 -->
        <TextView
            android:id="@+id/widgetTextTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Perfect Bit Rate"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium" />

        <!-- 2段目: アーティスト名 -->
        <TextView
            android:id="@+id/widgetTextArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="YouTube Music"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- ★ 3段目: シークライン (プログレスバー) ＆ 経過時間/総時間 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/widgetTextCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#888888"
                android:textSize="9.5sp"
                android:fontFamily="monospace" />

            <ProgressBar
                android:id="@+id/widgetProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="3.5dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/progress_bar_gold"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widgetTextTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#888888"
                android:textSize="9.5sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右端: 白丸枠ボタン群 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/widgetBtnPrev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="⏮"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/bg_btn_walkman_circle_small"
            android:padding="0dp"
            android:gravity="center"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/widgetBtnPlayPause"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_walkman_circle_large"
            android:padding="0dp"
            android:gravity="center"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/widgetBtnNext"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="⏭"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="@drawable/bg_btn_walkman_circle_small"
            android:padding="0dp"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>