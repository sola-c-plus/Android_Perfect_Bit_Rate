<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dap"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#E5A93C"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DEVELOPER PRESET TUNER"
            android:textColor="#E5A93C"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05" />

        <Button
            android:id="@+id/btnDevClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="✕"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:background="@drawable/bg_btn_icon"
            android:padding="0dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#161616"
        android:padding="10dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TARGET PRESET (調律対象)"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="内部設定を紐付けるDSEEプリセット"
                android:textColor="#888888"
                android:textSize="9.5sp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerTargetPreset"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_spinner_dap"
            android:popupBackground="#1A1A1A" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FIR Filter Character"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/devSpinnerFir"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_spinner_dap"
            android:popupBackground="#1A1A1A" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Transient Recovery Mode"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/devSpinnerTransient"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_spinner_dap"
            android:popupBackground="#1A1A1A" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LPC Spectral Algorithm"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/devSpinnerLpcAlgo"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_spinner_dap"
            android:popupBackground="#1A1A1A" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gain / Freq"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <Spinner
            android:id="@+id/devSpinnerGain"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="28dp"
            android:background="@drawable/bg_spinner_dap"
            android:popupBackground="#1A1A1A"
            android:layout_marginEnd="6dp" />

        <Spinner
            android:id="@+id/devSpinnerExtractFreq"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="28dp"
            android:background="@drawable/bg_spinner_dap"
            android:popupBackground="#1A1A1A" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#222222"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="QMF サブバンド Noise-to-Tone 分離"
            android:textColor="#CCCCCC"
            android:textSize="10.5sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/devSwitchQmf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@null"
            app:trackTint="@null"
            android:thumb="@drawable/switch_thumb_white"
            app:track="@drawable/switch_track_walkman_outline" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="トランジェント群遅延補正 (Group Delay)"
            android:textColor="#CCCCCC"
            android:textSize="10.5sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/devSwitchGroupDelay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@null"
            app:trackTint="@null"
            android:thumb="@drawable/switch_thumb_white"
            app:track="@drawable/switch_track_walkman_outline" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="格子型適応過渡予測 (Lattice PARCOR)"
            android:textColor="#CCCCCC"
            android:textSize="10.5sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/devSwitchLattice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@null"
            app:trackTint="@null"
            android:thumb="@drawable/switch_thumb_white"
            app:track="@drawable/switch_track_walkman_outline" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LR 独立シード ディザリング (空間拡散)"
            android:textColor="#E5A93C"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/devSwitchLrDither"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@null"
            app:trackTint="@null"
            android:thumb="@drawable/switch_thumb_white"
            app:track="@drawable/switch_track_walkman_outline"
            android:checked="true" />
    </LinearLayout>

    <!-- ★ ステップ2: M/S 空間・残響超解像 (初期値 ON 点灯) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M/S 空間・残響超解像 (Spatial Ambience)"
                android:textColor="#E5A93C"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sideステレオ残響超解像 ＆ 超高域空間拡散"
                android:textColor="#888888"
                android:textSize="9sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/devSwitchMsSpatial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@null"
            app:trackTint="@null"
            android:thumb="@drawable/switch_thumb_white"
            app:track="@drawable/switch_track_walkman_outline"
            android:checked="true" />
    </LinearLayout>

    <!-- ★ ステップ3: 動的カットオフ検知 ＆ SBR (初期値 ON 点灯) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="動的カットオフ検知 ＆ SBR (Spectral Replication)"
                android:textColor="#E5A93C"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AAC/Opusの遮断周波数を自動追従し倍音構造を複製"
                android:textColor="#888888"
                android:textSize="9sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/devSwitchDynamicSbr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@null"
            app:trackTint="@null"
            android:thumb="@drawable/switch_thumb_white"
            app:track="@drawable/switch_track_walkman_outline"
            android:checked="true" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDevCopyConfig"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="📋 全プリセット設定コードをコピー (製品初期値用)"
        android:textColor="#000000"
        android:textSize="11sp"
        android:textStyle="bold"
        android:backgroundTint="#E5A93C"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnDevResetDefault"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:text="初期値にリセット"
        android:textColor="#888888"
        android:textSize="10sp"
        android:background="@drawable/bg_btn_dap_outline" />

</LinearLayout>