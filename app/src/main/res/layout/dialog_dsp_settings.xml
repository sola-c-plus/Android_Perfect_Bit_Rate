<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dspDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dap">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/accent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/dspHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DSP AUDIO SETTINGS"
            android:textColor="@color/accent"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_dap_condensed"
            android:letterSpacing="0.05" />

        <ImageButton
            android:id="@+id/btnDspDialogClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            android:background="@drawable/bg_btn_icon"
            android:padding="5dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <!-- ★ PR-C1: DIRECT 行＋カテゴリ見出し＋各セクション行は
             DspSettingsRows がコード生成してこのコンテナへ追加する。
             XML に残るのは行化できない EQ ブロックのみで、コード側で
             DIRECT 行の直後（従来位置）へ差し戻す。 -->
        <LinearLayout
            android:id="@+id/dspSectionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- 10-BAND EQUALIZER -->
            <LinearLayout
                android:id="@+id/layoutSectionEq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/main_background"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textEqTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10-BAND EQUALIZER"
                            android:textColor="@color/white"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_dap_heading" />

                        <TextView
                            android:id="@+id/textEqSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="64bit IIR + Realtime Spectrum"
                            android:textColor="@color/text_tertiary"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="2dp">

                            <TextView
                                android:id="@+id/textEqSwLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="EQ"
                                android:textColor="@color/label_gray"
                                android:textSize="9.5sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/font_dap_condensed"
                                android:layout_marginEnd="6dp" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchEqEnable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:thumbTint="@null"
                                app:trackTint="@null"
                                android:thumb="@drawable/switch_thumb_white"
                                app:track="@drawable/switch_track_walkman_outline"
                                android:checked="false" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/textSpecSwLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SPEC"
                                android:textColor="@color/accent"
                                android:textSize="9.5sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/font_dap_condensed"
                                android:layout_marginEnd="6dp" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchSpectrumEnable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:thumbTint="@null"
                                app:trackTint="@null"
                                android:thumb="@drawable/switch_thumb_white"
                                app:track="@drawable/switch_track_walkman_outline"
                                android:checked="true" />
                        </LinearLayout>

                        <Spinner
                            android:id="@+id/dialogSpinnerEqPreset"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_spinner_dap"
                            android:popupBackground="@color/surface_input" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.example.perfectbitrate.WalkmanEqView
                        android:id="@+id/walkmanEqView"
                        android:layout_width="wrap_content"
                        android:layout_height="170dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="170dp"
                        android:orientation="vertical"
                        android:gravity="top|center_horizontal"
                        android:paddingTop="4dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <Button
                            android:id="@+id/btnEqEdit"
                            android:layout_width="58dp"
                            android:layout_height="26dp"
                            android:text="調整"
                            android:textColor="@color/white"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_btn_dap_outline"
                            android:padding="0dp"
                            android:layout_marginBottom="4dp" />

                        <Button
                            android:id="@+id/btnEqSave"
                            android:layout_width="58dp"
                            android:layout_height="26dp"
                            android:text="保存"
                            android:textColor="@color/white"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_btn_dap_outline"
                            android:padding="0dp"
                            android:layout_marginBottom="4dp" />

                        <Button
                            android:id="@+id/btnEqDelete"
                            android:layout_width="58dp"
                            android:layout_height="26dp"
                            android:text="削除"
                            android:textColor="@color/danger"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_btn_dap_outline"
                            android:padding="0dp"
                            android:layout_marginBottom="4dp" />

                        <Button
                            android:id="@+id/btnEqFlat"
                            android:layout_width="58dp"
                            android:layout_height="26dp"
                            android:text="FLAT"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_dap_condensed"
                            android:background="@drawable/bg_btn_dap_outline"
                            android:padding="0dp" />

                        <LinearLayout
                            android:id="@+id/layoutEqAdjustControls"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:visibility="gone"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:id="@+id/textEqBandFreq"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4K Hz"
                                android:textColor="@color/label_gray"
                                android:textSize="10.5sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/font_dap_condensed" />

                            <TextView
                                android:id="@+id/textEqGainValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+0.0 dB"
                                android:textColor="@color/white"
                                android:textSize="11.5sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/font_dap_condensed"
                                android:layout_marginBottom="2dp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <ImageButton
                                    android:id="@+id/btnEqPlus"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_plus"
                                    android:scaleType="centerInside"
                                    android:background="@drawable/bg_btn_circle"
                                    android:padding="4dp"
                                    android:layout_marginEnd="4dp" />

                                <ImageButton
                                    android:id="@+id/btnEqMinus"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_minus"
                                    android:scaleType="centerInside"
                                    android:background="@drawable/bg_btn_circle"
                                    android:padding="4dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 下部ミニプレイヤー -->
    <LinearLayout
        android:id="@+id/dspDialogPlayerControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/main_background"
        android:elevation="12dp">

        <View
            android:id="@+id/dspPlayerDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#262626" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/dspPlayerCard"
                android:layout_width="58dp"
                android:layout_height="58dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#222222">

                <ImageView
                    android:id="@+id/dialogImageArtwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_badge_normal" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/dialogTextTrackTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="YouTube Music"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:fontFamily="@font/font_dap_heading" />

                <TextView
                    android:id="@+id/dialogTextTrackArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#BDBDBD"
                    android:textSize="12sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_marginTop="1dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/dialogTextCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp"
                        android:fontFamily="@font/font_dap_mono" />

                    <SeekBar
                        android:id="@+id/dialogSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progress="0"
                        android:progressTint="@color/accent"
                        android:thumbTint="@color/white"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp" />

                    <TextView
                        android:id="@+id/dialogTextTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp"
                        android:fontFamily="@font/font_dap_mono" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/dialogBtnPrevTrack"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_skip_previous"
                    android:scaleType="centerInside"
                    android:background="@drawable/bg_btn_walkman_circle_small"
                    android:padding="6dp"
                    android:layout_marginEnd="6dp" />

                <ImageButton
                    android:id="@+id/dialogBtnPlayPause"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_play"
                    android:scaleType="centerInside"
                    android:background="@drawable/bg_btn_walkman_circle_large"
                    android:padding="8dp"
                    android:layout_marginEnd="6dp" />

                <ImageButton
                    android:id="@+id/dialogBtnNextTrack"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_skip_next"
                    android:scaleType="centerInside"
                    android:background="@drawable/bg_btn_walkman_circle_small"
                    android:padding="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
