<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dspDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dap">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#444444"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/dspHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DSP AUDIO SETTINGS"
            android:textColor="#E5A93C"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05" />

        <!-- 閉じるボタン: SVG ✕ (ic_close) -->
        <ImageButton
            android:id="@+id/btnDspDialogClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            android:background="@drawable/bg_btn_icon"
            android:padding="5dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- DIRECT SOURCE -->
            <LinearLayout
                android:id="@+id/layoutSectionDirectSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#161616"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textDirectSourceTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DIRECT SOURCE"
                        android:textColor="#E5A93C"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:id="@+id/textDirectSourceSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="全DSPを無効化しダイレクト送信します"
                        android:textColor="#888888"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/dialogSwitchDirectSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@null"
                    app:trackTint="@null"
                    android:thumb="@drawable/switch_thumb_white"
                    app:track="@drawable/switch_track_walkman_outline"
                    android:checked="false" />
            </LinearLayout>

            <!-- 10-BAND EQUALIZER -->
            <LinearLayout
                android:id="@+id/layoutSectionEq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#080808"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textEqTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10-BAND EQUALIZER"
                            android:textColor="#FFFFFF"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textEqSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="64bit IIR + Realtime Spectrum"
                            android:textColor="#777777"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="2dp">

                            <TextView
                                android:id="@+id/textEqSwLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="EQ"
                                android:textColor="#CCCCCC"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchEqEnable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:thumbTint="@null"
                                app:trackTint="@null"
                                android:thumb="@drawable/switch_thumb_white"
                                app:track="@drawable/switch_track_walkman_outline"
                                android:checked="false" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/textSpecSwLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SPEC"
                                android:textColor="#E5A93C"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="6dp" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchSpectrumEnable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:thumbTint="@null"
                                app:trackTint="@null"
                                android:thumb="@drawable/switch_thumb_white"
                                app:track="@drawable/switch_track_walkman_outline"
                                android:checked="true" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.example.perfectbitrate.WalkmanEqView
                        android:id="@+id/walkmanEqView"
                        android:layout_width="wrap_content"
                        android:layout_height="170dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="170dp"
                        android:orientation="vertical"
                        android:gravity="top|center_horizontal"
                        android:paddingTop="12dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <Button
                            android:id="@+id/btnEqEdit"
                            android:layout_width="58dp"
                            android:layout_height="28dp"
                            android:text="調整"
                            android:textColor="#FFFFFF"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_btn_dap_outline"
                            android:padding="0dp"
                            android:layout_marginBottom="8dp" />

                        <Button
                            android:id="@+id/btnEqFlat"
                            android:layout_width="58dp"
                            android:layout_height="28dp"
                            android:text="FLAT"
                            android:textColor="#888888"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_btn_dap_outline"
                            android:padding="0dp"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:id="@+id/layoutEqAdjustControls"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/textEqBandFreq"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4K Hz"
                                android:textColor="#CCCCCC"
                                android:textSize="10.5sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-condensed" />

                            <TextView
                                android:id="@+id/textEqGainValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+0.0 dB"
                                android:textColor="#FFFFFF"
                                android:textSize="11.5sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginBottom="4dp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <!-- ★ EQ ＋: ic_plus -->
                                <ImageButton
                                    android:id="@+id/btnEqPlus"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:src="@drawable/ic_plus"
                                    android:scaleType="centerInside"
                                    android:background="@drawable/bg_btn_circle"
                                    android:padding="5dp"
                                    android:layout_marginEnd="6dp" />

                                <!-- ★ EQ －: ic_minus -->
                                <ImageButton
                                    android:id="@+id/btnEqMinus"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:src="@drawable/ic_minus"
                                    android:scaleType="centerInside"
                                    android:background="@drawable/bg_btn_circle"
                                    android:padding="5dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- BIT DEPTH -->
            <LinearLayout
                android:id="@+id/layoutSectionBitDepth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textBitDepthTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BIT DEPTH FORMAT"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textBitDepthSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DACへ伝送するPCMビット深度"
                        android:textColor="#777777"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/dialogSpinnerBitDepth"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_spinner_dap"
                    android:popupBackground="#1A1A1A" />
            </LinearLayout>

            <View
                android:id="@+id/dividerDsp1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C1C1C"
                android:layout_marginBottom="12dp" />

            <!-- DITHERING -->
            <LinearLayout
                android:id="@+id/layoutSectionDither"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textDitherTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DITHERING ALGORITHM"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textDitherSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="量子化ノイズ分散・SBMシェービング"
                        android:textColor="#777777"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/dialogSpinnerDither"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_spinner_dap"
                    android:popupBackground="#1A1A1A" />
            </LinearLayout>

            <View
                android:id="@+id/dividerDsp2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C1C1C"
                android:layout_marginBottom="12dp" />

            <!-- DC PHASE -->
            <LinearLayout
                android:id="@+id/layoutSectionDcPhase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textDcPhaseTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DC PHASE LINEARIZER"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textDcPhaseSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="アナログアンプ低域位相 (A/B Curve 2/4/8Hz)"
                        android:textColor="#777777"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/dialogSpinnerDcPhase"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_spinner_dap"
                    android:popupBackground="#1A1A1A" />
            </LinearLayout>

            <View
                android:id="@+id/dividerDsp3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C1C1C"
                android:layout_marginBottom="12dp" />

            <!-- FREQ -->
            <LinearLayout
                android:id="@+id/layoutSectionDsee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textDseeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FREQ ENGINE (倍音復元)"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textDseeSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="直交多項式による20k〜40kHz+超高域倍音補完"
                        android:textColor="#777777"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/dialogSpinnerDsee"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_spinner_dap"
                    android:popupBackground="#1A1A1A" />
            </LinearLayout>

            <View
                android:id="@+id/dividerDsp4"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C1C1C"
                android:layout_marginBottom="12dp" />

            <!-- UPSAMPLING -->
            <LinearLayout
                android:id="@+id/layoutSectionUpsample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textUpsampleTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ULTRA HQ UPSAMPLING"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textUpsampleSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ARM NEON 多段ポリフェーズFIR (96k/192k/384k)"
                        android:textColor="#777777"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/dialogSpinnerUpsample"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_spinner_dap"
                    android:popupBackground="#1A1A1A" />
            </LinearLayout>

            <!-- CASCADE FIR -->
            <LinearLayout
                android:id="@+id/layoutSectionCascadeFir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textCascadeFirTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MULTISTAGE CASCADE FIR"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textCascadeFirSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3段2x接続 (255→63→39 taps) 超低ノイズ補間"
                        android:textColor="#777777"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/dialogSwitchCascadeFir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@null"
                    app:trackTint="@null"
                    android:thumb="@drawable/switch_thumb_white"
                    app:track="@drawable/switch_track_walkman_outline"
                    android:checked="true" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 下部ミニプレイヤー -->
    <LinearLayout
        android:id="@+id/dspDialogPlayerControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#161616"
        android:elevation="12dp">

        <View
            android:id="@+id/dspPlayerDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#262626" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/dspPlayerCard"
                android:layout_width="58dp"
                android:layout_height="58dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#222222">

                <ImageView
                    android:id="@+id/dialogImageArtwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_badge_normal" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/dialogTextTrackTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="YouTube Music"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/dialogTextTrackArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#BDBDBD"
                    android:textSize="12.5sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_marginTop="1dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/dialogTextCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="#888888"
                        android:textSize="10.5sp"
                        android:fontFamily="monospace" />

                    <SeekBar
                        android:id="@+id/dialogSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progress="0"
                        android:progressTint="#E5A93C"
                        android:thumbTint="#FFFFFF"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp" />

                    <TextView
                        android:id="@+id/dialogTextTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="#888888"
                        android:textSize="10.5sp"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>

            <!-- ★ ミニプレイヤー操作ボタン: SVG Vector (ic_skip_previous, ic_play, ic_skip_next) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/dialogBtnPrevTrack"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_skip_previous"
                    android:scaleType="centerInside"
                    android:background="@drawable/bg_btn_walkman_circle_small"
                    android:padding="6dp"
                    android:layout_marginEnd="6dp" />

                <ImageButton
                    android:id="@+id/dialogBtnPlayPause"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_play"
                    android:scaleType="centerInside"
                    android:background="@drawable/bg_btn_walkman_circle_large"
                    android:padding="8dp"
                    android:layout_marginEnd="6dp" />

                <ImageButton
                    android:id="@+id/dialogBtnNextTrack"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_skip_next"
                    android:scaleType="centerInside"
                    android:background="@drawable/bg_btn_walkman_circle_small"
                    android:padding="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>