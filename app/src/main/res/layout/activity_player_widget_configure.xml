<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dap"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WIDGET THEME SETTING"
        android:textColor="#E5A93C"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ウィジェットの外観カラーを選択してください。"
        android:textColor="#888888"
        android:textSize="11sp"
        android:layout_marginBottom="16dp" />

    <RadioGroup
        android:id="@+id/radioGroupWidgetTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/radioDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌙 ダーク (Dark / 黒基調)"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/radioLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☀️ ライト (Light / 白基調)"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <RadioButton
            android:id="@+id/radioAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 端末設定に連動 (System Auto)"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </RadioGroup>

    <Button
        android:id="@+id/btnWidgetSave"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="設定を保存して適用"
        android:textColor="#000000"
        android:textSize="12sp"
        android:textStyle="bold"
        android:backgroundTint="#E5A93C" />
</LinearLayout>