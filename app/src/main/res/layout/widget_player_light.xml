<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_widget_player_light"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/widgetImageArtwork"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_badge_normal" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/widgetTextTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Perfect Bit Rate"
            android:textColor="#1C1C1E"
            android:textSize="13sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/widgetTextArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="YouTube Music"
            android:textColor="#636366"
            android:textSize="11sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/widgetTextCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#8E8E93"
                android:textSize="9.5sp"
                android:fontFamily="monospace" />

            <ProgressBar
                android:id="@+id/widgetProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="3.5dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/progress_bar_gold"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widgetTextTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#8E8E93"
                android:textSize="9.5sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/widgetBtnPrev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_skip_previous"
            android:tint="#1C1C1E"
            android:scaleType="centerInside"
            android:background="@drawable/bg_btn_walkman_circle_small_light"
            android:padding="5dp"
            android:layout_marginEnd="6dp" />

        <ImageButton
            android:id="@+id/widgetBtnPlayPause"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_play"
            android:tint="#1C1C1E"
            android:scaleType="centerInside"
            android:background="@drawable/bg_btn_walkman_circle_large_light"
            android:padding="6dp"
            android:layout_marginEnd="6dp" />

        <ImageButton
            android:id="@+id/widgetBtnNext"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_skip_next"
            android:tint="#1C1C1E"
            android:scaleType="centerInside"
            android:background="@drawable/bg_btn_walkman_circle_small_light"
            android:padding="5dp" />
    </LinearLayout>

</LinearLayout>