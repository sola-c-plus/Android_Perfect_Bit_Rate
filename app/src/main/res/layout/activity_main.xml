<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/topInfoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0D0D0D"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:elevation="8dp">

        <!-- 段 1: ステータスバッジ + DAC機器名 + CPU/RAMモニター + アクションボタン群 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/badgeDirect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIRECT STREAM"
                android:textColor="#000000"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_direct"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:fontFamily="@font/font_dap_condensed"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/textDacName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:text="WALKMAN"
                android:textColor="#F0F0F0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="@font/font_dap_heading" />

            <!-- ★ CPU / RAM モニター (SW連動で一括表示/非表示) -->
            <TextView
                android:id="@+id/textCpuRamMonitor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU: 0%  RAM: 0M"
                android:textColor="#888888"
                android:textSize="9.5sp"
                android:fontFamily="@font/font_dap_mono"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <!-- ★ モード切替チップ（仕様書 §7.2）: 専用バーは作らず既存ボタン列に
                 埋め込む。高さは増やさず、タップで即切替・現在のモードを表示する。 -->
            <TextView
                android:id="@+id/textModeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YT MUSIC"
                android:textColor="#E5A93C"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_icon"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:fontFamily="@font/font_dap_condensed"
                android:letterSpacing="0.04"
                android:layout_marginEnd="5dp" />

            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_reload"
                android:scaleType="centerInside"
                android:background="@drawable/bg_btn_icon"
                android:padding="4dp"
                android:layout_marginEnd="5dp" />

            <ImageButton
                android:id="@+id/btnDspSettings"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_dsp_sine"
                android:scaleType="centerInside"
                android:background="@drawable/bg_btn_icon"
                android:padding="3dp"
                android:layout_marginEnd="5dp" />

            <ImageButton
                android:id="@+id/btnUiSettings"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_settings_gear"
                android:scaleType="centerInside"
                android:background="@drawable/bg_btn_icon"
                android:padding="4dp" />
        </LinearLayout>

        <View
            android:id="@+id/panelDividerLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1C1C1C"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="4dp" />

        <!-- 段 2: レート & ビット + コーデック + 転送量 (シンプル表示) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/textRateBits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="48.0 kHz / 16 bit"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_dap_condensed"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/textCodec"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="OPUS 160 KBPS"
                android:textColor="#A0A0A0"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_dap_condensed"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/textTransfer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 MB"
                android:textColor="#666666"
                android:textSize="9.5sp"
                android:fontFamily="@font/font_dap_mono" />
        </LinearLayout>

        <!-- 段 3: PEAK L/R + バッファ健全度(BUF) & レンダリング遅延(LAT) + 有効ビット深度(BIT ACTIVE) -->
        <!-- 高さ固定 (18dp): SysMonitor 文字列の伸長でこの行が縦に伸びると、下の GeckoView が
             その分リサイズされてしまうため、行の高さ変動そのものを無くす。子は center_vertical で中央揃え。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textPeak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PEAK  L: -inf / R: -inf"
                android:textColor="#B0B0B0"
                android:textSize="9.5sp"
                android:fontFamily="@font/font_dap_mono"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- ★ バッファ健全度 & 真のDAC出力遅延 LAT (SW連動で一括表示/非表示) -->
            <TextView
                android:id="@+id/textBufferLatency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUF:100% LAT:0ms"
                android:textColor="#888888"
                android:textSize="9sp"
                android:fontFamily="@font/font_dap_mono"
                android:maxLines="1"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textBitDepth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BIT: 16/16 ACTIVE"
                android:textColor="#E5A93C"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_dap_mono" />
        </LinearLayout>

        <!-- 段 4: SONY WALKMAN 風対数アナログピークレベルメーター -->
        <com.example.perfectbitrate.WalkmanLevelMeterView
            android:id="@+id/walkmanLevelMeter"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="1dp" />

    </LinearLayout>

    <!-- ★ メイン領域: モードに応じて GeckoView と Local プレースホルダを切り替える。
         Local 側のライブラリブラウザは後続 PR でプレースホルダの位置に載る。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.mozilla.geckoview.GeckoView
            android:id="@+id/geckoview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/localPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#000000"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <!-- ★ Local ライブラリのヘッダー: タイトル＋最小限の操作
                 （再スキャン / SAF フォルダ追加）。取得範囲の本格的な設定 UI は
                 設定画面側の次 PR で実装する。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/textLocalTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LOCAL MUSIC"
                    android:textColor="#F0F0F0"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_dap_heading"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/btnLocalAddFolder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="フォルダ追加"
                    android:textColor="#E5A93C"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_icon"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:fontFamily="@font/font_dap_condensed"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnLocalRescan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="再スキャン"
                    android:textColor="#E5A93C"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_icon"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:fontFamily="@font/font_dap_condensed" />
            </LinearLayout>

            <!-- ★ 裏側の差分スキャン中に出す控えめな更新中インジケータ
                 （キャッシュ表示中用。件数が出るので進捗も追える） -->
            <LinearLayout
                android:id="@+id/localScanUpdating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressLocalUpdating"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/textLocalUpdating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="ライブラリを更新中…"
                    android:textColor="#888888"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textLocalMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="ライブラリは準備中です"
                android:textColor="#888888"
                android:textSize="12sp"
                android:gravity="center" />

            <!-- ★ スキャン進捗ブロック（初回読み込み・手動の再スキャン時に表示。
                 走査中は不定バー＋発見件数、メタデータ取得中は確定バー＋n/N 件、
                 現在処理中の対象名も出す） -->
            <LinearLayout
                android:id="@+id/localScanProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressLocalScan"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/textLocalScanStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#BBBBBB"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/textLocalScanCurrent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#777777"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="middle" />
            </LinearLayout>

            <!-- ★ ライブラリのタブバー（Phase 2-1: 全曲 / アルバム /
                 アーティスト / フォルダ）。選択状態の配色はコード側で
                 テーマに合わせて切り替える（updateLocalTabStyles）。 -->
            <LinearLayout
                android:id="@+id/localTabBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabLocalAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="全曲"
                    android:textColor="#F0F0F0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_dap_condensed" />

                <TextView
                    android:id="@+id/tabLocalAlbum"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="アルバム"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:fontFamily="@font/font_dap_condensed" />

                <TextView
                    android:id="@+id/tabLocalArtist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="アーティスト"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:fontFamily="@font/font_dap_condensed" />

                <TextView
                    android:id="@+id/tabLocalFolder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="フォルダ"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:fontFamily="@font/font_dap_condensed" />
            </LinearLayout>

            <!-- ★ 検索欄＋ソート切替（Phase 2-1）。検索はタイトル /
                 アーティスト / アルバムを対象にした部分一致フィルタ。
                 ソートは全曲タブの並び（タイトル / アーティスト /
                 アルバム）をダイアログで切り替える。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/editLocalSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_local_search"
                    android:hint="タイトル・アーティスト・アルバムで検索"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:textColor="#F0F0F0"
                    android:textColorHint="#777777"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnLocalSort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_icon"
                    android:fontFamily="@font/font_dap_condensed"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="タイトル順"
                    android:textColor="#E5A93C"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ★ グループ（アルバム等）へドリルダウンしたときのヘッダー。
                 戻るボタン＋グループ名。通常時は gone。 -->
            <LinearLayout
                android:id="@+id/localGroupHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnLocalBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_icon"
                    android:fontFamily="@font/font_dap_condensed"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="‹ 戻る"
                    android:textColor="#E5A93C"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textLocalGroupTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#F0F0F0"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ★ 一覧（曲リスト / グループリストを同じ ListView で出し分ける） -->
            <ListView
                android:id="@+id/localTrackList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:divider="#1C1C1C"
                android:dividerHeight="1dp"
                android:cacheColorHint="@android:color/transparent"
                android:listSelector="@android:color/transparent" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>