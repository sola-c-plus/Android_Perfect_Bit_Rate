<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- SONY WALKMAN 風 高級オーディオインフォメーションパネル -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0D0D0D"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:elevation="8dp">

        <!-- 1段目: DIRECTバッジ + 出力DAC名 + [↻ リロード] + [⚙ 設定] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/badgeDirect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIRECT STREAM"
                android:textColor="#000000"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_direct"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/textDacName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="WALKMAN"
                android:textColor="#F0F0F0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium" />

            <!-- リロードボタン -->
            <Button
                android:id="@+id/btnReload"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:text="↻"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_icon"
                android:padding="0dp"
                android:layout_marginEnd="6dp" />

            <!-- 設定ウィンドウ呼び出しボタン -->
            <Button
                android:id="@+id/btnSettings"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:text="⚙"
                android:textColor="#E5A93C"
                android:textSize="13sp"
                android:background="@drawable/bg_btn_icon"
                android:padding="0dp" />
        </LinearLayout>

        <!-- 区切り線 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1C1C1C"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="4dp" />

        <!-- 2段目: レート/ビット深度 + コーデック + 転送量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/textRateBits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="48.0 kHz / 16 bit"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:id="@+id/textCodec"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="OPUS 160 KBPS (最高音質)"
                android:textColor="#A0A0A0"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/textTransfer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 MB"
                android:textColor="#666666"
                android:textSize="9.5sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- 3段目: L/R ピーク数値 ＆ ゴールド統一ビット深度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textPeak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PEAK  L: 0.0 dB  /  R: 0.0 dB"
                android:textColor="#B0B0B0"
                android:textSize="9.5sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/textBitDepth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BIT: 16/16 ACTIVE"
                android:textColor="#E5A93C"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- 4段目: SONY WALKMAN 完全再現グラフィカル・レベルメーター -->
        <com.example.perfectbitrate.WalkmanLevelMeterView
            android:id="@+id/walkmanLevelMeter"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="1dp" />

    </LinearLayout>

    <!-- 下部：YouTube Music (GeckoView) -->
    <org.mozilla.geckoview.GeckoView
        android:id="@+id/geckoview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
