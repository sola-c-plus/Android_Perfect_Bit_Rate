<?xml version="1.0" encoding="utf-8"?>
<!-- ★ ルートは FrameLayout。通常 UI は mainRootLayout のみで、
     Local の再生画面はオーバーレイにせず Local コンテンツ領域内の
     ページとして出す（上部ステータスヘッダーは常時表示したまま）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/mainRootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#000000">

    <LinearLayout
        android:id="@+id/topInfoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0D0D0D"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:elevation="8dp">

        <!-- 段 1: ステータスバッジ + DAC機器名 + CPU/RAMモニター + アクションボタン群 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/badgeDirect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIRECT STREAM"
                android:textColor="#000000"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_direct"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:fontFamily="@font/font_dap_condensed"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/textDacName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:text="WALKMAN"
                android:textColor="#F0F0F0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="@font/font_dap_heading" />

            <!-- ★ CPU / RAM モニター (SW連動で一括表示/非表示) -->
            <TextView
                android:id="@+id/textCpuRamMonitor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU: 0%  RAM: 0M"
                android:textColor="#888888"
                android:textSize="9.5sp"
                android:fontFamily="@font/font_dap_mono"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <!-- ★ モード切替チップ（仕様書 §7.2）: 専用バーは作らず既存ボタン列に
                 埋め込む。高さは増やさず、タップで即切替・現在のモードを表示する。 -->
            <TextView
                android:id="@+id/textModeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YT MUSIC"
                android:textColor="#E5A93C"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_icon"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:fontFamily="@font/font_dap_condensed"
                android:letterSpacing="0.04"
                android:layout_marginEnd="5dp" />

            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_reload"
                android:scaleType="centerInside"
                android:background="@drawable/bg_btn_icon"
                android:padding="4dp"
                android:layout_marginEnd="5dp" />

            <ImageButton
                android:id="@+id/btnDspSettings"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_dsp_sine"
                android:scaleType="centerInside"
                android:background="@drawable/bg_btn_icon"
                android:padding="3dp"
                android:layout_marginEnd="5dp" />

            <ImageButton
                android:id="@+id/btnUiSettings"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_settings_gear"
                android:scaleType="centerInside"
                android:background="@drawable/bg_btn_icon"
                android:padding="4dp" />
        </LinearLayout>

        <View
            android:id="@+id/panelDividerLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1C1C1C"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="4dp" />

        <!-- 段 2: レート & ビット + コーデック + 転送量 (シンプル表示) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/textRateBits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="48.0 kHz / 16 bit"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_dap_condensed"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/textCodec"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="OPUS 160 KBPS"
                android:textColor="#A0A0A0"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_dap_condensed"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/textTransfer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 MB"
                android:textColor="#666666"
                android:textSize="9.5sp"
                android:fontFamily="@font/font_dap_mono" />
        </LinearLayout>

        <!-- 段 3: PEAK L/R + バッファ健全度(BUF) & レンダリング遅延(LAT) + 有効ビット深度(BIT ACTIVE) -->
        <!-- 高さ固定 (18dp): SysMonitor 文字列の伸長でこの行が縦に伸びると、下の GeckoView が
             その分リサイズされてしまうため、行の高さ変動そのものを無くす。子は center_vertical で中央揃え。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textPeak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PEAK  L: -inf / R: -inf"
                android:textColor="#B0B0B0"
                android:textSize="9.5sp"
                android:fontFamily="@font/font_dap_mono"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- ★ バッファ健全度 & 真のDAC出力遅延 LAT (SW連動で一括表示/非表示) -->
            <TextView
                android:id="@+id/textBufferLatency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUF:100% LAT:0ms"
                android:textColor="#888888"
                android:textSize="9sp"
                android:fontFamily="@font/font_dap_mono"
                android:maxLines="1"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textBitDepth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BIT: 16/16 ACTIVE"
                android:textColor="#E5A93C"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_dap_mono" />
        </LinearLayout>

        <!-- 段 4: SONY WALKMAN 風対数アナログピークレベルメーター -->
        <com.example.perfectbitrate.WalkmanLevelMeterView
            android:id="@+id/walkmanLevelMeter"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="1dp" />

    </LinearLayout>

    <!-- ★ メイン領域: モードに応じて GeckoView と Local プレースホルダを切り替える。
         Local 側のライブラリブラウザは後続 PR でプレースホルダの位置に載る。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.mozilla.geckoview.GeckoView
            android:id="@+id/geckoview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/localPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#000000"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <!-- ★ Local ライブラリのヘッダー: タイトル＋最小限の操作
                 （再スキャン / SAF フォルダ追加）。取得範囲の本格的な設定 UI は
                 設定画面側の次 PR で実装する。ブラウザ側のクロームのため、
                 「再生」タブ表示中はコード側で隠す（updateLocalChromeVisibility）。 -->
            <LinearLayout
                android:id="@+id/localHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/textLocalTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LOCAL MUSIC"
                    android:textColor="#F0F0F0"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_dap_heading"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/btnLocalAddFolder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="フォルダ追加"
                    android:textColor="#E5A93C"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_icon"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:fontFamily="@font/font_dap_condensed"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/btnLocalRescan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="再スキャン"
                    android:textColor="#E5A93C"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_icon"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:fontFamily="@font/font_dap_condensed" />
            </LinearLayout>

            <!-- ★ 裏側の差分スキャン中に出す控えめな更新中インジケータ
                 （キャッシュ表示中用。件数が出るので進捗も追える） -->
            <LinearLayout
                android:id="@+id/localScanUpdating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressLocalUpdating"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/textLocalUpdating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="ライブラリを更新中…"
                    android:textColor="#888888"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textLocalMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="ライブラリは準備中です"
                android:textColor="#888888"
                android:textSize="12sp"
                android:gravity="center" />

            <!-- ★ スキャン進捗ブロック（初回読み込み・手動の再スキャン時に表示。
                 走査中は不定バー＋発見件数、メタデータ取得中は確定バー＋n/N 件、
                 現在処理中の対象名も出す） -->
            <LinearLayout
                android:id="@+id/localScanProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressLocalScan"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/textLocalScanStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#BBBBBB"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/textLocalScanCurrent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#777777"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="middle" />
            </LinearLayout>

            <!-- ★ Local コンテンツ領域のページコンテナ: ブラウザ
                 ページ（検索 / ドリルダウン / 一覧）と再生ページ
                 （「再生」タブ）を出し分ける。上部ステータスヘッダー
                 （topInfoPanel）はこの外側にあるため、どちらのページ
                 でも隠れず常時表示される。 -->
            <FrameLayout
                android:id="@+id/localPageContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp">

                <!-- ★ ブラウザページ: 検索 / ソート、グループの
                     ドリルダウンヘッダー、曲・グループの一覧 -->
                <LinearLayout
                    android:id="@+id/localBrowserPage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- ★ 検索欄＋ソート切替（Phase 2-1）。検索は
                         タイトル / アーティスト / アルバムを対象に
                         した部分一致フィルタ。ソートは全曲タブの並び
                         （タイトル / アーティスト / アルバム）を
                         ダイアログで切り替える。ブラウザ系タブでのみ
                         表示され、「再生」タブではページごと隠れる。 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/editLocalSearch"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_local_search"
                            android:hint="タイトル・アーティスト・アルバムで検索"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp"
                            android:textColor="#F0F0F0"
                            android:textColorHint="#777777"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnLocalSort"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_btn_icon"
                            android:fontFamily="@font/font_dap_condensed"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="タイトル順"
                            android:textColor="#E5A93C"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- ★ グループ（アルバム等）へドリルダウンした
                         ときのヘッダー。戻るボタン＋グループ名。
                         通常時は gone。 -->
                    <LinearLayout
                        android:id="@+id/localGroupHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/btnLocalBack"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_btn_icon"
                            android:fontFamily="@font/font_dap_condensed"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="‹ 戻る"
                            android:textColor="#E5A93C"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textLocalGroupTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#F0F0F0"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- ★ 一覧（曲リスト / グループリストを同じ
                         ListView で出し分ける） -->
                    <ListView
                        android:id="@+id/localTrackList"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="6dp"
                        android:divider="#1C1C1C"
                        android:dividerHeight="1dp"
                        android:cacheColorHint="@android:color/transparent"
                        android:listSelector="@android:color/transparent" />
                </LinearLayout>

                <!-- ★ 再生ページ（「再生」タブ）: WALKMAN の再生画面
                     を手本にした、余白を広く取った中央寄せの
                     Now Playing（詳細は localNpContent 内のコメント）。
                     全画面オーバーレイにはせず Local コンテンツ領域内
                     のページとして表示するため、上部ステータス
                     ヘッダーは隠れない。色はテーマに合わせてコード側で
                     切り替える（applyThemeUi）。現在曲が無いときは
                     空状態（textNpEmpty）を出す。 -->
                <FrameLayout
                    android:id="@+id/localNowPlaying"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#000000"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/localNpContent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="10dp">

                        <!-- ★ WALKMAN の再生画面に寄せた中央寄せレイアウト:
                             アートワークは左右に余白を残して中央に置き、
                             その下にフォーマット、タイトル/アーティスト/
                             アルバムをいずれも中央寄せで静かに並べる。
                             「NOW PLAYING」ラベルは置かず、キュー位置は
                             シークバーの上に小さく中央表示する。 -->
                        <ImageView
                            android:id="@+id/imgNpArtwork"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="30dp"
                            android:layout_marginEnd="30dp"
                            android:layout_marginTop="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_local_artwork_placeholder" />

                        <TextView
                            android:id="@+id/textNpFormat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:textColor="#888888"
                            android:textSize="10.5sp"
                            android:fontFamily="@font/font_dap_mono"
                            android:ellipsize="end"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/textNpTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:textColor="#F0F0F0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_dap_heading"
                            android:ellipsize="end"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/textNpArtist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:textColor="#BBBBBB"
                            android:textSize="14sp"
                            android:ellipsize="end"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/textNpAlbum"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:ellipsize="end"
                            android:maxLines="1" />

                        <!-- ★ キュー位置（n / N）はシークバーの上に
                             小さく中央表示（WALKMAN の 56/307 形式） -->
                        <TextView
                            android:id="@+id/textNpQueuePosition"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center"
                            android:textColor="#888888"
                            android:textSize="10.5sp"
                            android:fontFamily="@font/font_dap_mono" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/textNpCurrentTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0:00"
                                android:textColor="#888888"
                                android:textSize="10.5sp"
                                android:fontFamily="@font/font_dap_mono" />

                            <SeekBar
                                android:id="@+id/seekNpProgress"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="1000"
                                android:progress="0"
                                android:progressTint="#E5A93C"
                                android:thumbTint="#FFFFFF"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp" />

                            <TextView
                                android:id="@+id/textNpTotalTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0:00"
                                android:textColor="#888888"
                                android:textSize="10.5sp"
                                android:fontFamily="@font/font_dap_mono" />
                        </LinearLayout>

                        <!-- ★ 操作行は WALKMAN 式: 左端にリピート、
                             右端にシャッフル、中央に 前へ/再生・
                             一時停止（大きめ）/次へ -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageButton
                                android:id="@+id/btnNpRepeat"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_repeat"
                                android:scaleType="centerInside"
                                android:background="@drawable/bg_btn_walkman_circle_small"
                                android:padding="9dp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <ImageButton
                                android:id="@+id/btnNpPrev"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/ic_skip_previous"
                                android:scaleType="centerInside"
                                android:background="@drawable/bg_btn_walkman_circle_small"
                                android:padding="9dp"
                                android:layout_marginEnd="10dp" />

                            <ImageButton
                                android:id="@+id/btnNpPlayPause"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_pause"
                                android:scaleType="centerInside"
                                android:background="@drawable/bg_btn_walkman_circle_large"
                                android:padding="13dp"
                                android:layout_marginEnd="10dp" />

                            <ImageButton
                                android:id="@+id/btnNpNext"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/ic_skip_next"
                                android:scaleType="centerInside"
                                android:background="@drawable/bg_btn_walkman_circle_small"
                                android:padding="9dp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <ImageButton
                                android:id="@+id/btnNpShuffle"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_shuffle"
                                android:scaleType="centerInside"
                                android:background="@drawable/bg_btn_walkman_circle_small"
                                android:padding="9dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ★ 空状態: 再生中の曲が無いときの表示 -->
                    <TextView
                        android:id="@+id/textNpEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="再生中の曲がありません"
                        android:textColor="#888888"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </FrameLayout>
            </FrameLayout>

            <!-- ★ ライブラリの下部タブバー: 左から 再生 / 全曲 /
                 アルバム / アーティスト / フォルダ。「再生」は再生
                 ページへの切替で、一覧で曲をタップして再生が始まった
                 ときも自動で切り替わる（明示タップ起点のみ。自動進行
                 や通知からの操作では切り替わらない）。選択状態の配色は
                 コード側でテーマに合わせて切り替える
                 （updateLocalTabStyles）。ドリルダウン中も含め Local
                 表示中は常に出し、タブ切替でドリルダウンから抜けられる
                 ようにする。 -->
            <LinearLayout
                android:id="@+id/localTabBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabLocalNowPlaying"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="再生"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:fontFamily="@font/font_dap_condensed" />

                <TextView
                    android:id="@+id/tabLocalAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="全曲"
                    android:textColor="#F0F0F0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_dap_condensed" />

                <TextView
                    android:id="@+id/tabLocalAlbum"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="アルバム"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:fontFamily="@font/font_dap_condensed" />

                <TextView
                    android:id="@+id/tabLocalArtist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="アーティスト"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:fontFamily="@font/font_dap_condensed" />

                <TextView
                    android:id="@+id/tabLocalFolder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="フォルダ"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:fontFamily="@font/font_dap_condensed" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    </LinearLayout>

</FrameLayout>