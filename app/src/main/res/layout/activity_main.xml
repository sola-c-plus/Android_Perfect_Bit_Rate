<?xml version="1.0" encoding="utf-8"?>
<!-- ★ ルートは FrameLayout。通常 UI は mainRootLayout のみで、
     Local の再生画面はオーバーレイにせず Local コンテンツ領域内の
     ページとして出す（上部ステータスヘッダーは常時表示したまま）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background">

    <LinearLayout
        android:id="@+id/mainRootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/main_background">

    <LinearLayout
        android:id="@+id/topInfoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/main_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:elevation="8dp">

        <!-- 段 1: ステータスバッジ + DAC機器名 + CPU/RAMモニター + アクションボタン群 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- ★ badgeDirect は文言が伸びても段1全体をはみ出させないよう
                 maxWidth で上限を付け、超過分は省略表示にする（歯車ボタン
                 が画面外へ押し出される問題の対策）。最長の定型文
                 「DIRECT STREAM [DSP 8x]」がフォントスケール 1.0 で
                 切れないよう上限は 120dp。 -->
            <TextView
                android:id="@+id/badgeDirect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_maxWidth="120dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="DIRECT STREAM"
                android:textColor="@color/black"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_direct"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:fontFamily="@font/font_dap_condensed"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/textDacName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:text="WALKMAN"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="@font/font_dap_heading" />

            <!-- ★ CPU / RAM モニター (SW連動で一括表示/非表示)
                 段1では textDacName と並んで縮小可能な側に回し、表示幅が
                 足りないときは末尾を省略する（wrap_content のままだと
                 右端のボタン群が画面外へ押し出されるため）。 -->
            <TextView
                android:id="@+id/textCpuRamMonitor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CPU: 0%  RAM: 0M"
                android:textColor="@color/text_secondary"
                android:textSize="9.5sp"
                android:fontFamily="@font/font_dap_mono"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <!-- ★ モード切替（仕様書 §7.2）: 専用バーは作らず既存ボタン列に
                 埋め込む。[ YT MUSIC | LOCAL ] の2セグメントのピル型
                 トグルで、選択中はアクセント色で塗る（配色はコード側の
                 updateModeSwitchUi がテーマと現在モードで決める）。
                 セグメントのタップで従来の単一路切替がそのまま動く。 -->
            <LinearLayout
                android:id="@+id/modeSwitchGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_mode_switch"
                android:padding="2dp"
                android:layout_marginEnd="5dp">

                <TextView
                    android:id="@+id/textModeYt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YT MUSIC"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:fontFamily="@font/font_dap_condensed"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/textModeLocal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCAL"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:fontFamily="@font/font_dap_condensed"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnReload"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_reload"
                android:scaleType="centerInside"
                android:background="@drawable/bg_btn_icon"
                android:padding="4dp"
                android:layout_marginEnd="5dp" />

            <ImageButton
                android:id="@+id/btnDspSettings"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_dsp_sine"
                android:scaleType="centerInside"
                android:background="@drawable/bg_btn_icon"
                android:padding="3dp"
                android:layout_marginEnd="5dp" />

            <ImageButton
                android:id="@+id/btnUiSettings"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_settings_gear"
                android:scaleType="centerInside"
                android:background="@drawable/bg_btn_icon"
                android:padding="4dp" />
        </LinearLayout>

        <View
            android:id="@+id/panelDividerLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="4dp" />

        <!-- 段 2: レート & ビット + コーデック + 転送量 (シンプル表示) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/textRateBits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="48.0 kHz / 16 bit"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_dap_condensed"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/textCodec"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="—"
                android:textColor="@color/text_status_codec"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_dap_condensed"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/textTransfer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 MB"
                android:textColor="@color/text_status_transfer"
                android:textSize="9.5sp"
                android:fontFamily="@font/font_dap_mono" />
        </LinearLayout>

        <!-- 段 3: PEAK L/R + バッファ健全度(BUF) & レンダリング遅延(LAT) + 有効ビット深度(BIT ACTIVE) -->
        <!-- 高さ固定 (18dp): SysMonitor 文字列の伸長でこの行が縦に伸びると、下の GeckoView が
             その分リサイズされてしまうため、行の高さ変動そのものを無くす。子は center_vertical で中央揃え。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textPeak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PEAK  L: -inf / R: -inf"
                android:textColor="@color/text_status_peak"
                android:textSize="9.5sp"
                android:fontFamily="@font/font_dap_mono"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- ★ バッファ健全度 & 真のDAC出力遅延 LAT (SW連動で一括表示/非表示) -->
            <!-- ★ 幅は textPeak と同じ 0dp+weight+ellipsize にし、BUF 文字列の増長
                 （DROP 累計の桁増し等）で行全体が画面幅を超えてはみ出さないようにする -->
            <TextView
                android:id="@+id/textBufferLatency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BUF:100% LAT:0ms"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:fontFamily="@font/font_dap_mono"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textBitDepth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BIT: 16/16 ACTIVE"
                android:textColor="@color/accent"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_dap_mono" />
        </LinearLayout>

        <!-- 段 4: SONY WALKMAN 風対数アナログピークレベルメーター -->
        <com.example.perfectbitrate.WalkmanLevelMeterView
            android:id="@+id/walkmanLevelMeter"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="1dp" />

    </LinearLayout>

    <!-- ★ メイン領域: モードに応じて GeckoView と Local プレースホルダを切り替える。
         Local 側のライブラリブラウザは後続 PR でプレースホルダの位置に載る。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.mozilla.geckoview.GeckoView
            android:id="@+id/geckoview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/localPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/main_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <!-- ★ Local 画面の見出し行（LOCAL MUSIC 表記＋フォルダ追加 /
                 再スキャン）は置かない（ユーザー指定で削除）。取得範囲の
                 管理は設定画面側に集約する。スキャン進捗の表示は下の
                 ブロックでまかなう。 -->

            <!-- ★ 裏側の差分スキャン中に出す控えめな更新中インジケータ
                 （キャッシュ表示中用。件数が出るので進捗も追える） -->
            <LinearLayout
                android:id="@+id/localScanUpdating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressLocalUpdating"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/textLocalUpdating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="ライブラリを更新中…"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textLocalMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="ライブラリは準備中です"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:gravity="center" />

            <!-- ★ スキャン進捗ブロック（初回読み込み・手動の再スキャン時に表示。
                 走査中は不定バー＋発見件数、メタデータ取得中は確定バー＋n/N 件、
                 現在処理中の対象名も出す） -->
            <LinearLayout
                android:id="@+id/localScanProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressLocalScan"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/textLocalScanStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_np_artist"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/textLocalScanCurrent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="middle" />
            </LinearLayout>

            <!-- ★ Local コンテンツ領域のページコンテナ: ブラウザ
                 ページ（検索 / ドリルダウン / 一覧）と再生ページ
                 （「再生」タブ）とキューページ（「キュー」タブ）を
                 出し分ける。上部ステータスヘッダー（topInfoPanel）は
                 この外側にあるため、どのページでも隠れず常時
                 表示される。 -->
            <FrameLayout
                android:id="@+id/localPageContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp">

                <!-- ★ ブラウザページ: 検索 / ソート、グループの
                     ドリルダウンヘッダー、曲・グループの一覧 -->
                <LinearLayout
                    android:id="@+id/localBrowserPage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- ★ 検索欄＋ソート切替（Phase 2-1）。検索は
                         タイトル / アーティスト / アルバムを対象に
                         した部分一致フィルタ。ソートは全曲タブの並び
                         （タイトル / アーティスト / アルバム）を
                         ダイアログで切り替える。ブラウザ系タブでのみ
                         表示され、「再生」タブではページごと隠れる。 -->
                    <LinearLayout
                        android:id="@+id/localSearchRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/editLocalSearch"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_local_search"
                            android:hint="タイトル・アーティスト・アルバムで検索"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_tertiary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnLocalSort"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_btn_icon"
                            android:fontFamily="@font/font_dap_condensed"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="タイトル順"
                            android:textColor="@color/accent"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- ★ グループ（アルバム等）へドリルダウンした
                         ときのヘッダー。戻るボタン＋グループ名。
                         通常時は gone。 -->
                    <LinearLayout
                        android:id="@+id/localGroupHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/btnLocalBack"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_btn_icon"
                            android:fontFamily="@font/font_dap_condensed"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="‹ 戻る"
                            android:textColor="@color/accent"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textLocalGroupTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- ★ 一覧（曲リスト / グループリストを同じ
                         ListView で出し分ける）。右端の A-Z
                         インデックスバーはこの枠に重ね、ページの
                         スライドと一体で動くようにする（中身は
                         コード側で組み立てる）。 -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="6dp">

                        <ListView
                            android:id="@+id/localTrackList"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:divider="@color/divider"
                            android:dividerHeight="1dp"
                            android:cacheColorHint="@android:color/transparent"
                            android:listSelector="@android:color/transparent" />

                        <!-- ★ A-Z インデックスバー: TRACKS の
                             タイトル順のときだけ右端に出す文字
                             ジャンプ。中身（文字の TextView 群）は
                             updateAzIndexBar が表示中リストの
                             グループ構成に合わせて組み立てる。 -->
                        <LinearLayout
                            android:id="@+id/localAzIndexBar"
                            android:layout_width="20dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="end"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <!-- ★ 再生ページ（「再生」タブ）: WALKMAN の再生画面
                     を手本にした、余白を広く取った中央寄せの
                     Now Playing（詳細は localNpContent 内のコメント）。
                     全画面オーバーレイにはせず Local コンテンツ領域内
                     のページとして表示するため、上部ステータス
                     ヘッダーは隠れない。色はテーマに合わせてコード側で
                     切り替える（applyThemeUi）。現在曲が無いときは
                     空状態（textNpEmpty）を出す。 -->
                <FrameLayout
                    android:id="@+id/localNowPlaying"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/main_background"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/localNpContent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="10dp">

                        <!-- ★ WALKMAN の再生画面に寄せた中央寄せレイアウト:
                             アートワークは左右に余白を残して中央に置き、
                             その下にフォーマット、タイトル/アーティスト/
                             アルバムをいずれも中央寄せで静かに並べる。
                             「NOW PLAYING」ラベルは置かず、キュー位置は
                             シークバーの上に小さく中央表示する。
                             縦位置は3つのスペーサ（上 : 中 : 下 =
                             重み 1 : 2 : 2）で余白を配分する：
                             アートワークは上寄りに置き、曲情報〜操作行
                             のブロックはアートワークとの間隔を広く
                             取って下寄りに置く（中央に固めない）。
                             下側にも余白を残し、ブロックが下部タブ
                             バーに張り付かないようにする。 -->

                        <!-- ★ 上側スペーサ（小さめにしてアートワークを上寄りに） -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:id="@+id/imgNpArtwork"
                            android:layout_width="match_parent"
                            android:layout_height="320dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:layout_marginTop="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_local_artwork_placeholder" />

                        <!-- ★ 中間スペーサ（アートワークと下側ブロックの
                             間隔を広く取り、曲情報〜操作行を下寄りに） -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="2" />

                        <TextView
                            android:id="@+id/textNpFormat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:textColor="@color/text_secondary"
                            android:textSize="10.5sp"
                            android:fontFamily="@font/font_dap_mono"
                            android:ellipsize="end"
                            android:maxLines="1" />

                        <!-- ★ タイトル行: 中央寄せのタイトル＋右端の
                             ★（プレイリスト追加）。左端にも ★ と
                             同幅のスペーサを置き、タイトルの中央
                             寄せが崩れないようにする。★ はタップで
                             最後に作成したプレイリストへ追加、
                             長押しで追加先の選択（WALKMAN の ★
                             の位置付けに寄せた導線）。 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="40dp"
                                android:layout_height="40dp" />

                            <TextView
                                android:id="@+id/textNpTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textColor="@color/text_primary"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/font_dap_heading"
                                android:ellipsize="end"
                                android:maxLines="2" />

                            <ImageButton
                                android:id="@+id/btnNpStar"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_star_outline"
                                android:scaleType="centerInside"
                                android:background="@null"
                                android:padding="8dp"
                                android:contentDescription="プレイリストに追加" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textNpArtist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:textColor="@color/text_np_artist"
                            android:textSize="16sp"
                            android:ellipsize="end"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/textNpAlbum"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:ellipsize="end"
                            android:maxLines="1" />

                        <!-- ★ キュー位置（n / N）はシークバーの上に
                             小さく中央表示（WALKMAN の 56/307 形式） -->
                        <TextView
                            android:id="@+id/textNpQueuePosition"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center"
                            android:textColor="@color/text_secondary"
                            android:textSize="10.5sp"
                            android:fontFamily="@font/font_dap_mono" />

                        <!-- ★ シークバーは左右に余白を持たせて短くし、
                             両端の時刻表示もバーの範囲内に揃える -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/textNpCurrentTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0:00"
                                android:textColor="@color/text_secondary"
                                android:textSize="10.5sp"
                                android:fontFamily="@font/font_dap_mono" />

                            <SeekBar
                                android:id="@+id/seekNpProgress"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="1000"
                                android:progress="0"
                                android:progressTint="@color/accent"
                                android:thumbTint="@color/white"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp" />

                            <TextView
                                android:id="@+id/textNpTotalTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0:00"
                                android:textColor="@color/text_secondary"
                                android:textSize="10.5sp"
                                android:fontFamily="@font/font_dap_mono" />
                        </LinearLayout>

                        <!-- ★ 操作行: 左端にシャッフル、右端に
                             リピート（ユーザー指定の並び）、中央に
                             前へ/再生・一時停止（大きめ）/次へ。
                             行に左右マージンを付けて両端のトグルを
                             画面端から内側へ寄せ、中央3ボタン間の
                             間隔も広めに取る。両端のトグルは円で
                             囲わずアイコンのみ（状態は色で示す）。
                             シークバーとの間隔はボタン類だけを少し
                             下げるため marginTop を広げてある
                             （シークバー側の位置は不変）。 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="36dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageButton
                                android:id="@+id/btnNpShuffle"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_shuffle"
                                android:scaleType="centerInside"
                                android:background="@null"
                                android:padding="9dp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <ImageButton
                                android:id="@+id/btnNpPrev"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/ic_skip_previous"
                                android:scaleType="centerInside"
                                android:background="@drawable/bg_btn_walkman_circle_small"
                                android:padding="10dp"
                                android:layout_marginEnd="18dp" />

                            <ImageButton
                                android:id="@+id/btnNpPlayPause"
                                android:layout_width="68dp"
                                android:layout_height="68dp"
                                android:src="@drawable/ic_pause"
                                android:scaleType="centerInside"
                                android:background="@drawable/bg_btn_walkman_circle_large"
                                android:padding="15dp"
                                android:layout_marginEnd="18dp" />

                            <ImageButton
                                android:id="@+id/btnNpNext"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/ic_skip_next"
                                android:scaleType="centerInside"
                                android:background="@drawable/bg_btn_walkman_circle_small"
                                android:padding="10dp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <ImageButton
                                android:id="@+id/btnNpRepeat"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_repeat"
                                android:scaleType="centerInside"
                                android:background="@null"
                                android:padding="9dp" />
                        </LinearLayout>

                        <!-- ★ 下側スペーサ（下側ブロックが下部タブバーに
                             張り付かないよう、適度な余白を残す） -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="2" />
                    </LinearLayout>

                    <!-- ★ 空状態: 再生中の曲が無いときの表示 -->
                    <TextView
                        android:id="@+id/textNpEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="再生中の曲がありません"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- ★ キューページ（「キュー」タブ）: LocalPlayer の
                     実効再生順（シャッフル時はシャッフル後の順序）を
                     一覧表示する。行の見た目はライブラリの曲行と共通
                     （LocalTrackAdapter）で、再生中の曲がハイライト
                     される。行タップでその曲へジャンプする。キューが
                     無いときは空状態を出す。ブラウザページとは独立
                     したページにし、検索 / ドリルダウンの状態と
                     干渉しないようにする。 -->
                <FrameLayout
                    android:id="@+id/localQueuePage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <ListView
                        android:id="@+id/localQueueList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="@color/divider"
                        android:dividerHeight="1dp"
                        android:cacheColorHint="@android:color/transparent"
                        android:listSelector="@android:color/transparent" />

                    <!-- ★ 空状態: キューが無いときの表示 -->
                    <TextView
                        android:id="@+id/textQueueEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="再生キューがありません"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </FrameLayout>
            </FrameLayout>

            <!-- ★ ライブラリの下部タブバー: 左から キュー / 再生 /
                 ライブラリ の3つ。ライブラリは WALKMAN OS の
                 ライブラリートップに相当する専用ページで、TRACKS /
                 ALBUMS / ARTISTS / PLAYLISTS の4項目が並び、項目
                 タップで各ビューへ入る（PLAYLISTS もここへ統合）。
                 各タブはアイコン（ic_tab_*）＋ラベルの構成で、選択
                 状態の配色（アイコンの tint とラベル色）はコード側で
                 テーマに合わせて切り替える（updateLocalTabStyles）。
                 「再生」は再生ページへの切替で、一覧で曲をタップして
                 再生が始まったときも自動で切り替わる（明示タップ
                 起点のみ。自動進行や通知からの操作では切り替わら
                 ない）。ドリルダウン中も含め Local 表示中は常に
                 出し、タブ切替でドリルダウンから抜けられるように
                 する。 -->
            <LinearLayout
                android:id="@+id/localTabBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabLocalQueue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:drawableTop="@drawable/ic_tab_queue"
                    android:drawablePadding="3dp"
                    android:text="QUEUE"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:fontFamily="@font/font_dap_condensed" />

                <TextView
                    android:id="@+id/tabLocalNowPlaying"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:drawableTop="@drawable/ic_tab_now_playing"
                    android:drawablePadding="3dp"
                    android:text="PLAY"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:fontFamily="@font/font_dap_condensed" />

                <TextView
                    android:id="@+id/tabLocalLibrary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:drawableTop="@drawable/ic_tab_library"
                    android:drawablePadding="3dp"
                    android:text="LIBRARY"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:fontFamily="@font/font_dap_condensed" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    </LinearLayout>

</FrameLayout>