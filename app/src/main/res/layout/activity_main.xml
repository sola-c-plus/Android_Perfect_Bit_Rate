<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- SONY WALKMAN 風 高級オーディオインフォメーションパネル -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0D0D0D"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:elevation="8dp">

        <!-- 1段目: DIRECTバッジ + 出力DAC名 + 全スイッチ集約 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/badgeDirect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIRECT STREAM"
                android:textColor="#000000"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_direct"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/textDacName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="WALKMAN"
                android:textColor="#F0F0F0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium" />

            <Spinner
                android:id="@+id/spinnerBitDepth"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/bg_spinner_dap"
                android:popupBackground="#1A1A1A"
                android:layout_marginEnd="6dp"
                android:gravity="center_vertical" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAdBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AD CUT"
                android:textColor="#CCCCCC"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:checked="true"
                app:switchPadding="4dp"
                app:thumbTint="@null"
                app:trackTint="@null"
                android:thumb="@drawable/switch_thumb_white"
                app:track="@drawable/switch_track_walkman_outline"
                android:layout_marginEnd="6dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchVolLock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0dB"
                android:textColor="#CCCCCC"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:checked="false"
                app:switchPadding="4dp"
                app:thumbTint="@null"
                app:trackTint="@null"
                android:thumb="@drawable/switch_thumb_white"
                app:track="@drawable/switch_track_walkman_outline"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnReload"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:text="↻"
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#222222"
                android:padding="0dp" />
        </LinearLayout>

        <!-- 区切り線 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1C1C1C"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp" />

        <!-- 2段目: レート/ビット深度 + コーデック + 転送量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/textRateBits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="48.0 kHz / 16 bit"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:id="@+id/textCodec"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="OPUS 160 KBPS (最高音質)"
                android:textColor="#A0A0A0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/textTransfer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 MB"
                android:textColor="#666666"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- 3段目: L/R ピークメーター ＆ ゴールド統一ビット深度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textPeak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PEAK  L: 0.0 dB  /  R: 0.0 dB"
                android:textColor="#B0B0B0"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/textBitDepth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BIT: 16/16 ACTIVE"
                android:textColor="#E5A93C"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

    </LinearLayout>

    <!-- 下部：YouTube Music (GeckoView) -->
    <org.mozilla.geckoview.GeckoView
        android:id="@+id/geckoview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>