<?xml version="1.0" encoding="utf-8"?>
<!-- ★ ダイアログ UI 統一 PR-C: Spinner ドロップダウン専用の背景（ライト）。
     bg_bottom_sheet_dap_light と同じ地・枠トークンで、四隅角丸 16dp の
     ポップアップ専用形にしたもの（シート用 drawable の流用をやめる）。 -->
