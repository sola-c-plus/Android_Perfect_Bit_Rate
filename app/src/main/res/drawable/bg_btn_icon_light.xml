<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/component_inactive_light" />
            <stroke android:width="1dp" android:color="@color/component_line_light" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/main_background_light" />
            <stroke android:width="1dp" android:color="@color/component_border_light" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>