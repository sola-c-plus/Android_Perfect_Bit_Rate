        <shape android:shape="rectangle">
            <size android:height="16dp" android:width="34dp" />
            <corners android:radius="8dp" />
            <solid android:color="#F2F2F7" />
            <stroke android:width="1.5dp" android:color="#D49B28" />
        </shape>
    </item>
    <item>
