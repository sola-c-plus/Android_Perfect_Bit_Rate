<?xml version="1.0" encoding="utf-8"?>
<!-- ★ Local ライブラリの検索欄の背景（ダークテーマ用）。
     既存の入力系ボタン背景（bg_btn_icon）と同じ色味に寄せている。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_button" />
    <stroke
        android:width="1dp"
        android:color="@color/surface_pressed" />
    <corners android:radius="6dp" />
</shape>
